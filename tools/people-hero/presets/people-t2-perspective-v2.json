{
  "schemaVersion": 2,
  "id": "people-t2-perspective-v2",
  "width": 2560,
  "height": 1440,
  "layout": "t2-perspective",
  "format": "webp",
  "quality": 82,
  "targetBytes": 256000,
  "targetIsHardLimit": false,
  "sourcePolicy": "official-tmdb-artwork-only",
  "titleLogoBakedIn": false,
  "filmography": {
    "minimumCredits": 15,
    "maximumCredits": 32,
    "mediaTypes": ["movie", "tv"],
    "roles": ["cast", "director"],
    "minimumTvEpisodes": 2,
    "oneEpisodeExceptionFile": "data/hero-credit-overrides.json",
    "excludeAdult": true,
    "excludeSelf": true,
    "excludeUncredited": true,
    "excludeArchiveFootage": true,
    "requirePosterOrBackdrop": true,
    "maximumFallbackProfiles": 3
  },
  "profileOnly": {
    "minimumProfiles": 15,
    "maximumProfiles": 24,
    "portraitTilesOnly": true
  },
  "sparseFallback": {
    "id": "people-t2-cinematic-defocus-fallback-v1",
    "minimumCredits": 1,
    "sourceOrder": "eligible-credit-rank",
    "artworkPreference": ["poster", "backdrop"],
    "blurSigma": 34,
    "saturation": 0.82,
    "brightness": 0.7,
    "titleLogoBakedIn": false,
    "upgradeWhenNormalHeroEligible": true
  },
  "refresh": {
    "intervalMonths": 2,
    "minimumChangedSelections": 2,
    "singleNewCreditTopRank": 8,
    "minimumChangedProfileSelections": 3,
    "stageOnly": true
  }
}
