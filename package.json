{
  "name": "nuvio-people-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Public People artwork assets for Nuvio",
  "type": "module",
  "scripts": {
    "manifest": "node scripts/build-manifest.mjs",
    "people-hero:eligibility": "node tools/people-hero/src/eligibility.mjs",
    "people-hero:preflight": "node tools/people-hero/src/preflight.mjs",
    "people-hero:stage": "node tools/people-hero/src/stage.mjs",
    "people-hero:refresh-audit": "node tools/people-hero/src/refresh-audit.mjs",
    "people-hero:refresh-stage": "node tools/people-hero/src/refresh-stage.mjs",
    "people-hero:refresh-issue": "node tools/people-hero/src/refresh-issue.mjs",
    "people-hero:refresh-promote": "node tools/people-hero/src/refresh-promote.mjs",
    "people-base:consolidate-sources": "node tools/people-seed/src/consolidate-source-caches.mjs",
    "people-base:stage": "node tools/people-seed/src/stage-base-artwork.mjs",
    "people-title-logo:v2-proof": "node tools/people-seed/src/title-logo-v2-proof.mjs",
    "people-intake:stage": "node tools/people-intake/src/stage.mjs",
    "people-intake:promote": "node tools/people-intake/src/promote.mjs",
    "validate": "node scripts/validate-assets.mjs",
    "test": "node --test tools/people-hero/tests/*.test.mjs tools/people-intake/tests/*.test.mjs tools/people-seed/tests/*.test.mjs && npm run validate"
  },
  "devDependencies": {
    "sharp": "0.35.3",
    "skia-canvas": "3.0.8"
  },
  "engines": {
    "node": ">=20"
  }
}
